+def label_curve(ax, x, y, text, color, x_at, above=True, dy_dec=0.10, fontsize=9.5):
+    """Write `text` along the curve (x, y) at x_at, rotated with the curve in display
+    space, a tenth of a decade above (or below) it. Replaces the legend of panel (a),
+    which no empty corner of a 1/f^2 family can hold without crossing a curve."""
+    i = int(np.clip(np.searchsorted(x, x_at), 1, len(x) - 2))
+    p0 = ax.transData.transform((x[i - 1], y[i - 1])); p1 = ax.transData.transform((x[i + 1], y[i + 1]))
+    ang = np.degrees(np.arctan2(p1[1] - p0[1], p1[0] - p0[0]))
+    ax.text(x[i], y[i] * 10 ** (dy_dec if above else -dy_dec), text, rotation=ang,
+            rotation_mode="anchor", ha="center", va="bottom" if above else "top",
+            color=color, fontsize=fontsize * TSCALE)
+
+
+fig.canvas.draw()
+for tau_ms, x_at, above in ((0.05, 3.5, True), (0.2, 1.2, False), (1.0, 1.2, True), (15.0, 1.2, True)):
